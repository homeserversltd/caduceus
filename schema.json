          "path": "/run/caduceus/staff.sock",
          "audience": "local staff",
          "connection_info": "Linux peer credentials (uid,gid,pid)",
          "authorization": {
            "filesystem": {
              "owner": "root",
              "owner_group": "owner",
              "mode": "0660"
            },
            "existing_http_policy": true,
            "attendance": true,
            "peer_credentials": "observational/audit-only; not admission"
          },
          "lifecycle": {
            "parent_directory": {
              "owner": "root",
              "owner_group": "root",
              "mode": "0755"
            },
            "stale_socket": "type/liveness-safe refusal unless connect probe is refused",
            "shutdown_cleanup": "remove only the socket identity created by this process"
          }
        }
      },
      "event_streaming": {
        "status": "deferred",
        "inheritance": "workflow-coronatio-subscription-broadcast-arcadia-inheritance-contract"
      }
    }
  },
