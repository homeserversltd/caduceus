    "ROUTINE": "Fixed roles brain=text-to-text, embed=embedding, ear=speech-to-text; a null model is an empty stopped slot.",
    "TARGET": "/etc/appliance/config.json local_ai",
    "FLAGS": "Optional mmproj on ear; unknown fields preserved."
  },
  "canonical_bytes": "UTF-8 JSON, two-space indentation and one trailing LF."
}
