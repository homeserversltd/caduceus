    },
    "slots": {
      "type": "object",
      "fields": {
        "brain": {
          "type": "object",
          "fields": {
            "role": {
              "type": "string",
              "const": "text-to-text"
            },
            "model": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255,
              "description": "One file name on shelf; null empties the slot and stops its process."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "ctx": {
              "type": "integer",
              "minimum": 1
            },
            "lan": {
              "type": "boolean"
            }
          },
          "required": [
            "role",
            "model",
            "port",
            "ctx",
            "lan"
          ],
          "unknown_fields_preserved": true
        },
        "embed": {
          "type": "object",
          "fields": {
            "role": {
              "type": "string",
              "const": "embedding"
            },
            "model": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255,
              "description": "One file name on shelf; null empties the slot and stops its process."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "ctx": {
              "type": "integer",
              "minimum": 1
            },
            "lan": {
              "type": "boolean"
            }
          },
          "required": [
            "role",
            "model",
            "port",
            "ctx",
            "lan"
          ],
          "unknown_fields_preserved": true
        },
        "ear": {
          "type": "object",
          "fields": {
            "role": {
              "type": "string",
              "const": "speech-to-text"
            },
            "model": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255,
              "description": "One file name on shelf; null empties the slot and stops its process."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "ctx": {
              "type": "integer",
              "minimum": 1
            },
            "lan": {
              "type": "boolean"
            },
            "mmproj": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255,
              "description": "Paired projector file on shelf, or null when empty."
