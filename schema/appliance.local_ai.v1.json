{
  "schema": "appliance.local_ai.v1",
  "schema_version": "1.0.0",
  "role": "HomeSI local_ai declaration in /etc/appliance/config.json. Caduceus alone writes model/mmproj through its sole-writer lever; staff and Harmonia read this seat.",
  "authority": {
    "owner": "caduceus",
    "path": "schema/appliance.local_ai.v1.json"
  },
  "evolution": {
    "law": "additive-only",
    "unknown_fields_preserved": true,
    "missing_field_semantics": "Absent optional fields select null primitive behavior."
  },
  "required": [
    "schema",
    "shelf",
    "slots"
  ],
  "fields": {
    "schema": {
      "type": "string",
      "const": "appliance.local_ai.v1"
    },
    "shelf": {
      "type": "string",
      "description": "Absolute model shelf directory, born as /home/owner/Models."
    },
    "edition": {
      "type": ["string", "null"],
      "enum": ["memory", null],
      "description": "Optional owner-selected memory edition."
    },
