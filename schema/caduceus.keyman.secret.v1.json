{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "caduceus.keyman.secret.v1",
  "schema_version": "1.0.0",
  "role": "Keyman named-secret HTTP request; the reply is the shared staff receipt.",
  "authority": {
    "owner": "caduceus",
    "path": "schema/caduceus.keyman.secret.v1.json"
  },
  "evolution": {
    "law": "additive-only",
    "unknown_fields_skipped": true,
    "missing_field_semantics": "An absent about is null."
  },
  "type": "object",
  "required": ["name", "value"],
  "properties": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$"},
    "about": {
      "type": ["string", "null"],
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "description": "Optional short description with no control characters."
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 511,
      "pattern": "^[^\\u0000\\r\\n\"]+$",
      "writeOnly": true,
      "description": "Secret: 1–511 UTF-8 bytes, no NUL, CR, LF or double quote; sent to staff only on stdin. The door enforces the byte limit."
    }
  },
  "http": {
    "method": "POST",
    "path": "/api/v1/keyman/secret",
    "administrative": true,
    "mutation_allowed": true
  },
  "receipt_schema": "caduceus.staff.receipt.v1",
  "secrecy": {
    "request_body_logged": false,
    "response_body_logged": false,
    "value_returned": false,
    "value_transport": "stdin-only"
  },
  "additionalProperties": true
}
