{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "caduceus.notifications.v1",
  "schema_version": "1.0.0",
  "role": "Guest-readable household notifications and Admin Mode link-up receipts",
  "authority": {
    "owner": "caduceus",
    "path": "schema/caduceus.notifications.v1.json"
  },
  "evolution": {
    "law": "additive-only",
    "unknown_fields_skipped": true,
    "unknown_fields_preserved": true,
    "missing_field_semantics": "Missing optional fields mean null; missing request names uses the face declaration; dry_run missing or null means execute after admission"
  },
  "required": [
    "schema"
  ],
  "fields": {
    "schema": {
      "type": "string",
      "const": "caduceus.notifications.v1"
    },
    "notifications": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "fields": {
          "id": {
            "type": "string",
            "description": "Stable link-up:<lowercase stave MAC>:<face port> identity"
          },
          "kind": {
            "type": "string",
            "description": "First kind is house-link-up; unknown kinds are skipped by semantic readers"
          },
          "state": {
            "type": "string",
            "description": "Pending requests only in the list; an admitted first name disappears, not another pending request"
          },
          "title": {
            "type": "string"
          },
          "color": {"type": ["string", "null"], "description": "red, amber, blue, or none; absent reads none"},
          "body": {"type": ["string", "null"]},
          "posted_at": {"type": ["string", "null"]},
          "ttl": {"type": ["string", "null"], "description": "until-acted, night, or a duration in hours or days"},
          "expires_at": {"type": ["string", "null"]},
          "acted_at": {"type": ["string", "null"]},
          "actions": {"type": ["array", "null"], "items": {"type": "object", "additionalProperties": true}},
          "max_rows": {"type": ["integer", "null"], "description": "Per-kind history bound; factory 50"},
          "received_from": {"type": ["string", "null"], "description": "Address observed by the receiving Caduceus socket"},
          "from": {
            "type": "object",
            "fields": {
              "hostname": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "canonical_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ipv4": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mac": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "upstream": {
            "type": "string"
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "notification": {"type": ["object", "null"], "additionalProperties": true, "description": "One raw notification row for a post or forward; unknown fields survive."},
    "repost": {"type": ["boolean", "null"], "description": "When true, a dismissed or expired identity can be posted again."},
    "forwarded": {"type": ["boolean", "null"], "description": "A peer returned the gateway's post receipt."},
    "id": {"type": ["string", "null"]},
    "state": {"type": ["string", "null"]},
    "staff": {"type": ["object", "null"], "additionalProperties": true},
    "gateway": {
      "type": [
        "string",
        "null"
      ],
      "description": "unreachable on a peer when its discovered gateway door cannot answer; notifications is empty"
    },
    "ok": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "portal": {
      "type": [
        "string",
        "null"
      ]
    },
    "names": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "firstMissingSignal": {
      "type": [
        "string",
        "null"
      ]
    },
    "dry_run": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "attempted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "argv": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "child_portals": {
      "type": ["array", "null"],
      "description": "Optional per-entry child portal bind results; dry-run entries carry planned argv and attempted=false."
    }
  },
  "forms": {
    "post": {"required": ["notification"], "description": "Pinless LAN post; a peer forwards once to the gateway."},
    "forward": {"required": ["notification"], "description": "Pinless gateway-only forward; no roster admission."},
    "action": {"required": [], "description": "Action fields as an object; gateway attendance is required."},
    "list": {
      "required": [
        "schema",
        "notifications"
      ]
    },
    "accept": {
      "required": [],
      "description": "names omitted or null selects declared names. Unknown fields are skipped. Optional dry_run validates names and returns the exact caduceus cert portal-admit argv without invoking the staff."
    },
    "dismiss": {
      "required": []
    },
    "receipt": {
      "required": [
        "ok"
      ],
      "description": "The complete portal-admit staff receipt, including additive unknown fields, plus portal and names. A failed composite is never accepted."
    }
  },
  "http": {
    "post": {"method":"POST", "path":"/api/v1/notifications", "admin_mode_required":false, "mutation_allowed":true},
    "forward": {"method":"POST", "path":"/api/v1/notifications/forward", "admin_mode_required":false, "mutation_allowed":true},
    "action": {"method":"POST", "path":"/api/v1/notifications/{id}/{verb}", "admin_mode_required":true, "mutation_allowed":true},
    "history": {"method":"GET", "path":"/api/v1/notifications?all=1", "admin_mode_required":true, "mutation_allowed":false, "description":"Gateway-only history; peers return an empty list with gateway=history-on-homeserver."},
    "read": {
      "method": "GET",
      "path": "/api/v1/notifications",
      "guest_readable": true,
      "mutation_allowed": false
    },
    "accept": {
      "method": "POST",
      "path": "/api/v1/notifications/{id}/accept",
      "admin_mode_required": true
    },
    "dismiss": {
      "method": "POST",
      "path": "/api/v1/notifications/{id}/dismiss",
      "admin_mode_required": true
    }
  },
  "signals": [
    "link-up-name-invalid",
    "link-up-name-taken",
    "link-up-admin-required",
    "link-up-accept-on-homeserver"
  ],
  "secrecy": {
    "request_body_logged": false,
    "response_body_logged": false,
    "new_credentials": false
  },
  "additionalProperties": true
}
