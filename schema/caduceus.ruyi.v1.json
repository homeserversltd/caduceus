{
  "schema": "caduceus.ruyi.v1",
  "schema_version": "1.3.0",
  "role": "Public Ruyi row, roster and removal envelope",
  "authority": {
    "owner": "caduceus",
    "path": "schema/caduceus.ruyi.v1.json"
  },
  "evolution": {
    "law": "additive-only",
    "missing_field_semantics": "Absent optional fields select null primitive behavior",
    "unknown_fields_preserved": true,
    "form_kernel_semantics": "The envelope required kernel applies to every form. Each forms.<name>.required declares that form's additional frozen required kernel; fields required by a form are not optional in that form."
  },
  "fields": {
    "schema": {
      "type": "string",
      "const": "caduceus.ruyi.v1"
    },
    "mac": {
      "type": "string",
      "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$"
    },
    "hostname": {
      "type": "string",
      "description": "Self-declared lowercase hostname, 1 through 63 bytes"
    },
    "canonical_name": {
      "type": "string",
      "description": "home maps to the home.arpa apex; every other hostname maps to <hostname>.home.arpa"
    },
    "ipv4": {
      "type": "string",
      "format": "ipv4"
    },
    "caduceus_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "TCP port on the row ipv4 where this body Caduceus serves public LAN doors"
    },
    "ipv4_source": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "dns",
        "declared",
        null
      ],
      "description": "Seat-written address source; absent or null on older rows"
    },
    "services": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "fields": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "model": {
            "type": ["string", "null"],
            "description": "Absent model is normalized to null"
          },
          "protocol": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          }
        },
        "required": ["kind", "port", "path", "protocol"],
        "optional": ["model"]
      },
      "description": "Optional services announced by this stave, stored in its existing row JSON and served only while it answers the ordinary Caduceus probe. Missing, null, non-array or empty means none; malformed entries are dropped without refusing the row or perspective.self. Accepted entries preserve unknown additive fields. A face service may carry names: an ordered list of requested *.home.arpa names (portal first, aliases after), preserved for household notifications. Empty results are omitted, and discovered-only staves have no services."
    },
    "profile": {
      "type": "string"
    },
    "gui_face": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Hyprland",
        "Arcadia",
        "Coronatio",
        "Sway",
        "Noesis",
        null
      ]
    },
    "caduceus_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "env_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rustc_version": {
      "type": "string",
      "description": "Rust compiler release version from rustc -Vv, or unset when unavailable"
    },
    "harmonia_rustc_version": {
      "type": "string",
      "description": "rustc release version compiled into the body's Harmonia engine"
    },
    "rustc_installed": {
      "type": "string",
      "description": "rustc release version on the body's own system PATH; absent when the body carries no toolchain"
    },
    "harmonia_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "syzygy_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "stamp_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "description": "Optional externally attested stamp for this row; Caduceus only carries and compares it"
    },
    "fire_seal": {
      "type": [
        "object",
        "null"
      ],
      "fields": {
        "band": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "licensee": {
          "type": "string"
        },
        "issued": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "band",
        "licensee",
        "issued"
      ],
      "description": "Optional fire-seal projection; unknown additive fields are preserved by readers"
    },
    "last_seen": {
      "type": "integer",
      "description": "Unix acceptance time written by the seat"
    },
    "last_update": {
      "type": [
        "object",
        "null"
      ],
      "fields": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "converged": {
          "type": "boolean"
        }
      },
      "required": [
        "run_id",
        "converged"
      ]
    },
    "perspective": {
      "schema_ref": "harmonia.ruyi-perspective.v1",
      "nullable": true
    },
    "stats": {
      "schema_ref": "caduceus.appliance.stats.sample.v1",
      "nullable": true
    },
    "stats_signal": {
      "type": ["string", "null"],
      "pattern": "^(timeout|refused-[1-5][0-9]{2}|malformed|too-large|unreachable)$"
    },
    "ok": {
      "type": "boolean"
    },
    "service": {
      "type": "string",
      "const": "caduceus"
    },
    "seat": {
      "type": "object",
      "fields": {
        "mac": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "ipv4_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "dns",
            "bind-lan-fallback",
            null
          ],
          "description": "Address selected from the DNS answer or declared LAN bind fallback"
        },
        "stats": {
          "schema_ref": "caduceus.appliance.stats.sample.v1",
          "nullable": true
        },
        "stats_signal": {
          "type": ["string", "null"],
          "pattern": "^(timeout|refused-[1-5][0-9]{2}|malformed|too-large|unreachable)$"
        }
      }
    },
    "staves": {
      "type": "array",
      "items": {
        "schema_ref": "caduceus.ruyi.v1",
        "form": "roster-staff"
      }
    },
    "perspectives": {
      "type": "object",
      "values": {
        "schema_ref": "harmonia.ruyi-perspective.v1"
      }
    },
    "trust": {
      "type": "array",
      "items": {
        "type": "object",
        "fields": {
          "mac": {
            "type": "string"
          },
          "syzygy_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "const": "stamp",
            "description": "Present only on an additional stamp trust projection; absent rows retain legacy syzygy/BeamPair meaning"
          },
          "stamp_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "beam_pair": {
            "type": "object",
            "fields": {
              "caduceus_sha": {
                "type": "string"
              },
              "env_sha": {
                "type": "string"
              }
            }
          },
          "witnesses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Distinct sorted registered MACs attesting the target"
          },
          "agree": {
            "type": "integer"
          },
          "of": {
            "type": "integer"
          },
          "first_seen": {
            "type": "integer",
            "description": "Earliest retained agreeing event for this target"
          },
          "last_seen": {
            "type": "integer",
            "description": "Latest retained agreeing event for this target"
          },
          "last_event": {
            "type": "integer",
            "description": "Latest retained event concerning this target, including divergence"
          }
        }
      }
    },
    "removed": {
      "type": "string"
    },
    "dns_unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "fields": {
          "mac": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "canonical_name": {
            "type": "string"
          },
          "ipv4": {
            "type": "string",
            "format": "ipv4"
          }
        }
      },
      "description": "Stored rows marked declared while the DNS view has records; empty without a DNS view"
    },
    "discovered_via": {
      "type": "string",
      "const": "lease-sweep"
    }
  },
  "field_types": {
    "schema": "string",
    "mac": "string",
    "hostname": "string",
    "canonical_name": "string",
    "ipv4": "string",
    "caduceus_port": "integer",
    "services": "array|null",
    "ipv4_source": "string|null",
    "profile": "string",
    "gui_face": "string|null",
    "caduceus_sha": "string",
    "env_sha": "string",
    "rustc_version": "string",
    "harmonia_rustc_version": "string",
    "rustc_installed": "string",
    "harmonia_sha": "string|null",
    "syzygy_sha": "string|null",
    "stamp_sha": "string|null",
    "fire_seal": "object|null",
    "last_seen": "integer",
    "last_update": "object|null",
    "perspective": "object|null",
    "stats": "object|null",
    "stats_signal": "string|null",
    "ok": "boolean",
    "service": "string",
    "seat": "object",
    "staves": "array",
    "perspectives": "object",
    "trust": "array",
    "dns_unresolved": "array",
    "removed": "string",
    "discovered_via": "string"
  },
  "required": [
    "schema"
  ],
  "optional": [
    "services",
    "gui_face",
    "ipv4_source",
    "dns_unresolved",
    "syzygy_sha",
    "stamp_sha",
    "fire_seal",
    "last_seen",
    "perspective",
    "perspectives",
    "trust",
    "rustc_version",
    "harmonia_rustc_version",
    "rustc_installed",
    "stats",
    "stats_signal"
  ],
  "forms": {
    "row": {
      "required": [
        "schema",
        "mac",
        "hostname",
        "canonical_name",
        "ipv4",
        "profile",
        "caduceus_sha",
        "env_sha",
        "harmonia_sha",
        "last_update"
      ],
      "optional": [
        "gui_face",
        "ipv4_source",
        "caduceus_port",
        "services",
        "syzygy_sha",
        "stamp_sha",
        "fire_seal",
        "rustc_version",
        "harmonia_rustc_version",
        "rustc_installed",
        "last_seen",
        "perspective"
      ]
    },
    "roster": {
      "required": [
        "schema",
        "ok",
        "service",
        "seat",
        "staves"
      ],
      "optional": [
        "perspectives",
        "dns_unresolved",
        "trust"
      ]
    },
    "removed": {
      "required": [
        "schema",
        "ok",
        "removed"
      ],
      "optional": []
    },
    "discovered": {
      "required": [
        "schema",
        "mac",
        "hostname",
        "canonical_name",
        "ipv4",
        "ipv4_source",
        "profile",
        "caduceus_sha",
        "env_sha",
        "last_seen",
        "discovered_via"
      ],
      "optional": [
        "gui_face",
        "rustc_version",
        "harmonia_sha",
        "syzygy_sha",
        "stamp_sha",
        "fire_seal",
        "last_update",
        "stats",
        "stats_signal"
      ]
    },
    "roster-staff": {
      "required": [
        "schema",
        "mac",
        "hostname",
        "canonical_name",
        "ipv4"
      ],
      "optional": [
        "ipv4_source",
        "caduceus_port",
        "services",
        "profile",
        "gui_face",
        "caduceus_sha",
        "env_sha",
        "rustc_version",
        "harmonia_rustc_version",
        "rustc_installed",
        "harmonia_sha",
        "syzygy_sha",
        "stamp_sha",
        "fire_seal",
        "last_seen",
        "last_update",
        "discovered_via",
        "stats",
        "stats_signal"
      ]
    }
  },
  "canonical_bytes": "UTF-8 JSON, two-space indentation and one trailing LF. GET schema serves these exact file bytes."
}
