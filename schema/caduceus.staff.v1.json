{
  "schema": "caduceus.staff.v1",
  "kernel": {
    "fields": [
      "schema",
      "intent_id",
      "transition",
      "version",
      "timestamp"
    ],
    "required": [
      "schema",
      "intent_id",
      "transition",
      "version",
      "timestamp"
    ]
  },
  "routine": {
    "optional": true,
    "fields": {
      "routine_id": "string",
      "request": "original envelope",
      "stage": {
        "stage_id": "string",
        "arguments": "object"
      }
    },
    "unknown_fields_preserved": true
  },
  "payload": {
    "optional": true,
    "fields": "command-specific fields declared by the intent's own seat (schema/intents/<noun…>/<verb>.json) once it stands; until then, by the route template (routes/<namespace>/index.json) and the stop",
    "absent": "empty object (primitive)",
    "null": "explicit null is read exactly as absent: empty object (primitive)",
    "unknown_fields_preserved": true
  },
  "origin_of_intent": {
    "near": "acts on this machine alone, no further data needed",
    "far": [
      "list of one or more destination identifiers -- mac, ip, body name, or named service -- this intent reaches toward"
    ]
  },
  "serpents_shelf": {
    "path": "/usr/local/sbin"
  },
  "transport_protocol": {
    "http": "existing per-route request/response bodies, unchanged, for every LAN-open caller that isn't Arcadia",
    "socket": {
      "schema": "caduceus.transport.v1",
      "kind": "dual-transport",
      "transports": {
        "tcp": {
          "address": "0.0.0.0:8787",
          "audience": "LAN-open HTTP callers",
          "connection_info": "peer SocketAddr",
          "authorization": {
            "existing_http_policy": true,
            "attendance": true
          }
        },
        "staff-uds": {
          "path": "/run/caduceus/staff.sock",
          "audience": "local staff",
          "connection_info": "Linux peer credentials (uid,gid,pid)",
          "authorization": {
            "filesystem": {
              "owner": "root",
              "owner_group": "owner",
              "mode": "0660"
            },
            "existing_http_policy": true,
            "attendance": true,
            "peer_credentials": "observational/audit-only; not admission"
          },
          "lifecycle": {
            "parent_directory": {
              "owner": "root",
              "owner_group": "root",
              "mode": "0755"
            },
            "stale_socket": "type/liveness-safe refusal unless connect probe is refused",
            "shutdown_cleanup": "remove only the socket identity created by this process"
          }
        }
      },
      "event_streaming": {
        "status": "deferred",
        "inheritance": "workflow-coronatio-subscription-broadcast-arcadia-inheritance-contract"
      }
    }
  },
  "flags": {
    "presence_gated": true,
    "version_compared": false,
    "families": {
      "benchmark": {
        "shape": "boolean",
        "absent": "primitive",
        "native_benchmark": {
          "schema": "caduceus.benchmark.v1",
          "receive_locus": "receive",
          "serve_locus": "serve:<ordinal>:<band>",
          "serve_ordinal_base": 1
        }
      },
      "exousia": {
        "shape": {
          "pin": "string, 1 to 512 bytes"
        },
        "absent": "primitive (no PIN offered)",
        "carriers": "HTTP request body to a door or stdin envelope to cli.py; never a command line",
        "door": "verify against global.admin.pin and remove or redact before a stop, log, receipt or reply",
        "law": [
          "pali:appliance-pin-in-once-and-you-are-in-law-20261103 (Carriers)",
          "pali:workflow-coronatio-upload-tab-parity-emerald-tablet (UploadVerify)"
        ]
      }
    }
  },
  "required": [
    "schema",
    "intent_id",
    "transition",
    "version",
    "timestamp"
  ]
}
