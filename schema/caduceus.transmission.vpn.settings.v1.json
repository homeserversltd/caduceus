{
  "schema": "caduceus.transmission.vpn.settings.v1",
  "schema_version": "1.0.0",
  "role": "Caduceus Transmission VPN settings response and configuration domain",
  "authority": {
    "owner": "caduceus",
    "path": "schema/caduceus.transmission.vpn.settings.v1.json"
  },
  "evolution": {
    "law": "additive-only",
    "unknown_fields_preserved": true,
    "missing_field_semantics": "Absent configuration values use the declared null default."
  },
