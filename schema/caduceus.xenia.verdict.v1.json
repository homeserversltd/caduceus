{
  "schema": "caduceus.xenia.verdict.v1",
  "schema_version": "1.0.0",
  "role": "Xenia door outcome and proposed admission row; not a household configuration schema",
  "authority": {
    "owner": "caduceus",
    "path": "schema/caduceus.xenia.verdict.v1.json"
  },
  "evolution": {
    "law": "additive-only",
    "unknown_fields_preserved": true,
    "missing_field_semantics": "Absent optional fields select null primitive behavior; only the named form kernel is required."
  },
  "required": [
    "schema",
    "ok",
    "verdict"
  ],
  "fields": {
    "schema": {
      "type": "string",
      "const": "caduceus.xenia.verdict.v1"
    },
    "ok": {
      "type": "boolean"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "admissible",
        "admitted",
        "removed",
        "status",
        "ran",
        "refused"
      ]
    },
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "check": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "suggestion": {
      "type": "string"
    },
    "entry": {
      "schema_ref": "appliance.xenia.v1",
      "form": "entry"
    },
    "tabs": {
      "type": "object",
      "description": "Only the proposed guest row produced by C1. Unknown household fields survive. This does not govern the whole native registry or config document.",
      "required": [
        "displayName",
        "order",
        "visibility",
        "adminOnly",
        "data"
      ],
      "fields": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "visibility": {
          "type": "object",
          "fields": {
            "tab": {
              "type": "boolean"
            },
            "elements": {
              "type": "object",
              "values": {
                "type": "boolean"
              }
            }
          }
        },
        "adminOnly": {
          "type": "boolean"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "seat": {
      "type": "object",
      "required": [
        "path",
        "created"
      ],
      "fields": {
        "path": {
          "type": "string"
        },
        "created": {
          "type": "boolean"
        }
      }
    },
    "seat_retained": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "observed": {
      "type": "object"
    },
    "attempt": {
      "type": "object"
    },
    "final": {
      "type": "object"
    },
    "xenoi": {
      "type": "object",
      "values": {
        "schema_ref": "appliance.xenia.v1",
        "form": "entry"
      }
    },
    "runtime": {
      "type": "object",
      "description": "Single guest runtime for status/:id, or a map of id to runtime for whole-register status. Each row follows projections.status_runtime; guest ids are never interpreted as runtime field names. Health and source comparison are live read-only evidence."
    },
    "receipt": {
      "type": "object"
    },
    "envelope": {
      "type": "object"
    }
  },
  "projections": {
    "status_runtime": {
      "type": "object",
      "fields": {
        "running_source_sha": {
          "type": ["string", "null"],
          "description": "The running guest's source_sha from a well-formed xenia.health.v1 reply; null when absent or the read is unusable."
        },
        "installed_source_sha": {
          "type": ["string", "null"],
          "description": "The register entry's installed.source_sha; never updated by status."
        },
        "currentness": {
          "type": "string",
          "enum": ["current", "out-of-date", "unknown"]
        },
        "currentness_reason": {
          "type": "string",
          "description": "source-sha-match, source-sha-mismatch, installed-source-sha-absent, running-source-sha-absent, health-unreachable, health-malformed, health-service-mismatch, health-route-invalid, health-route-absent, health-loopback-endpoint-absent, process-not-observed, or not-process."
        },
        "health": {
          "type": "string",
          "description": "Process status reads report healthy, unhealthy, or unreachable. The existing non-process and entry-absent projections retain unobserved or unknown."
        },
        "health_reason": {
          "type": "string",
          "description": "The live health-read outcome, separate from whether the installed and running source SHAs match."
        }
      },
      "optional": ["running_source_sha", "installed_source_sha", "currentness", "currentness_reason", "health", "health_reason"]
    }
  },
  "field_types": {
    "schema": "string",
    "ok": "boolean",
    "verdict": "string",
    "id": "string|null",
    "check": "string",
    "field": "string",
    "message": "string",
    "suggestion": "string",
    "entry": "appliance.xenia.v1:entry",
    "tabs": "object",
    "seat": "object",
    "seat_retained": "boolean",
    "changed": "boolean",
    "observed": "object",
    "attempt": "object",
    "final": "object",
    "xenoi": "map<id,appliance.xenia.v1:entry>",
    "runtime": "object",
    "receipt": "object",
    "envelope": "object"
  },
  "optional": [
    "id",
    "check",
    "field",
    "message",
    "suggestion",
    "entry",
    "tabs",
    "seat",
    "seat_retained",
    "changed",
    "observed",
    "attempt",
    "final",
    "xenoi",
    "runtime",
    "receipt",
    "envelope"
  ],
  "admission_policy": {
    "forbidden_instructions": [
      "dependencies",
      "packages",
      "apt",
      "pip",
      "npm",
      "sudoers",
      "shell",
      "command",
      "commands",
      "clone",
      "rebuild",
      "instructions",
      "install_script",
      "unit_text",
      "authorized_keys",
      "private_key",
      "keys",
      "dotfiles"
    ],
    "forbidden_inventory_names": [
      "passwd",
      "shadow",
      "sudoers",
      "authorized_keys",
      "id_rsa",
      "id_ed25519",
      ".ssh",
      ".gnupg",
      ".bashrc",
      ".profile"
    ],
    "forbidden_inventory_suffixes": [
      ".service",
      ".socket",
      ".timer",
      ".sudoers"
    ],
    "forbidden_row_keys": [
      "__proto__",
      "constructor",
      "prototype"
    ]
  },
  "forms": {
    "refusal": {
      "required": [
        "check",
        "field",
        "message",
        "suggestion"
      ]
    },
    "admissible": {
      "required": [
        "entry",
        "tabs"
      ]
    },
    "ran": {
      "required": [
        "receipt"
      ]
    }
  },
  "canonical_bytes": "UTF-8 JSON, two-space indentation and one trailing LF."
}
