{
  "schema": "caduceus.carapace.v1",
  "profile": "specula",
  "gui_face": null,
  "mode": "specula",
  "services": {
    "update": {
      "timer": "harmonia.timer",
      "latest_receipt": "/var/lib/harmonia/receipts/update-latest/run.json"
    }
  },
  "harmonia_routes": {
    "interactable_list": {
      "bin": "/usr/local/bin/harmonia",
      "args": [
        "interactable",
        "list",
        "--json"
      ],
      "raw_json": true
    },
    "interactable_run": {
      "bin": "/usr/local/bin/harmonia",
      "args": [
        "interactable",
        "run"
      ],
      "positional": true,
      "raw_json": true
    },
    "interactable_silence": {
      "bin": "/usr/local/bin/harmonia",
      "args": [
        "interactable",
        "silence"
      ],
      "positional": true,
      "raw_json": true
    },
    "interactable_unsilence": {
      "bin": "/usr/local/bin/harmonia",
      "args": [
        "interactable",
        "unsilence"
      ],
      "positional": true,
      "raw_json": true
    },
    "update_now": {
      "bin": "/usr/local/bin/harmonia",
      "args": [
        "update",
        "--apply"
      ]
    },
    "update_check": {
      "bin": "/usr/local/bin/harmonia",
      "args": [
        "update",
        "--check"
      ],
      "raw_json": true
    },
    "update_module": {
      "bin": "/usr/local/bin/harmonia",
      "raw_json": true
    }
  },
  "sclerites": [
    "*",
    "nmcli=n"
  ]
}
