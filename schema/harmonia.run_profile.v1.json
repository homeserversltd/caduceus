{
  "schema": "harmonia.run_profile.v1",
  "schema_version": "1.0.0",
  "role": "Harmonia profile run receipt",
  "authority": {"owner": "caduceus", "path": "schema/harmonia.run_profile.v1.json"},
  "evolution": {"law": "additive-only", "missing_field_semantics": "Absent optional fields mean null", "unknown_fields_preserved": true},
  "required": ["schema", "run_id", "ok"],
  "optional": ["changed", "mutation", "mode", "profile_id", "identity", "identity_source", "module_count", "operation_count", "config_proposal_count", "run_duration_ms", "first_missing_signal", "module_spine_entered", "selected_profile", "suite_ok", "steps", "module_artifact_debt", "engine_debt", "overall_ok", "degraded", "config_surfaces", "extends", "base_profile_id", "union_module_count", "excluded_module_ids", "observed", "could_change_to", "attempt", "final_receipt", "notify"],
