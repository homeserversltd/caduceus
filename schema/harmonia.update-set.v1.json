{
  "schema": "harmonia.update-set.v1",
  "schema_version": "1.1.0",
  "role": "Harmonia's appliance update-set and member release evidence",
  "authority": {
    "owner": "caduceus",
    "path": "schema/harmonia.update-set.v1.json",
    "grant": "Operator-elected public seat for the Harmonia update-set"
  },
  "evolution": {
    "law": "additive-only",
    "missing_field_semantics": "Absent optional fields mean no evidence; an unresolved syzygy remains a signal, not failed module convergence",
    "unknown_fields_preserved": true
  },
  "fields": {
    "schema": {
      "type": "string",
      "const": "harmonia.update-set.v1"
    },
    "profile": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type_ref": "Member"
      }
    },
    "member_flags": {
      "type": "object",
      "values": {
        "one_of": [
          {
            "type_ref": "MemberFlag"
          },
          {
            "type": "string",
            "description": "Unresolved member flag signal"
          }
        ]
      }
    },
    "syzygy_signal": {
      "type": "string"
    },
    "syzygy_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "set_verdict": {
      "type": "string",
      "enum": [
        "ok",
        "failed",
        "failed-rolled-back",
        "failed-rollback-incomplete"
      ],
      "description": "ok: the set committed; failed: the press was red and nothing was restored; failed-rolled-back: every held root and service was restored and verified; failed-rollback-incomplete: a restoration was owed and is not whole"
    },
    "transaction_state": {
      "type": "string",
      "enum": [
        "Open",
        "Applied",
        "Committed",
        "RolledBack",
        "RollbackIncomplete",
        "RefusedForeignPostImage"
      ]
    },
    "restored_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failed_step": {
      "type": "string"
    }
  },
  "field_types": {
    "schema": "string",
    "profile": "string",
    "members": "array<Member>",
    "member_flags": "map<member,MemberFlag|string>",
    "syzygy_signal": "string",
    "syzygy_sha": "string|null",
    "set_verdict": "string",
    "transaction_state": "string",
    "restored_paths": "array<string>",
    "rollback_errors": "array<string>",
    "failed_step": "string"
  },
  "required": [
    "schema",
    "members",
    "syzygy_signal"
  ],
  "optional": [
    "profile",
    "member_flags",
    "syzygy_sha",
    "set_verdict",
    "transaction_state",
    "restored_paths",
    "rollback_errors",
    "failed_step"
  ],
  "types": {
    "Member": {
      "fields": {
        "source_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "ordinal": {
          "type": "integer"
        },
        "member": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "standing",
            "rolled-back",
            "rollback-incomplete",
            "not-restored"
          ],
          "description": "standing: the set committed; rolled-back: a member with a held root or service was restored; rollback-incomplete: restoration was not whole; not-restored: a member of a red press none of whose roots or services were held"
        }
      },
      "description": "Member observations retain their existing fields unchanged; source_sha is additive release evidence"
    },
    "MemberFlag": {
      "fields": {
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "flagged_at": {
          "type": "string"
        },
        "malformed_flags": {
          "type": "integer"
        }
      }
    }
  },
  "canonical_bytes": "UTF-8 JSON, two-space indentation and one trailing LF. GET schema serves these exact file bytes."
}
