        "update-check-profile-unavailable",
        "update-check-module-projection-failed",
        "update-check-sidecar-unobserved",
        "update-check-routine-unobserved",
        "update-check-step-unobserved",
        "update-check-index-refresh-failed",
        "update-check-package-unobserved",
        "update-check-ledger-unavailable",
        "update-check-ledger-unobserved",
        "caduceus-stats-store-unavailable"
      ]
    },
    "checked_at": {
