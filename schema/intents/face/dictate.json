{
  "schema": "caduceus.staff.v1",
  "intent": "face/dictate",
  "payload": {"fields": {}, "required": []},
  "exousia": false,
  "mutation_allowed": true,
  "returns": {
    "verb": {"type": "string", "const": "dictate", "meaning": "Face operation answered."},
    "host": {"type": "string", "meaning": "Hostname of the responding staff."},
    "timestamp": {"type": "string", "meaning": "UTC receipt timestamp."},
    "benchmark": {"type": "object", "meaning": "Shared timings when benchmarking is requested."},
    "state": {"type": "string", "enum": ["recording", "transcribed"], "meaning": "Recording started, or transcription was copied and pasted."},
    "chars": {"type": "integer", "meaning": "Transcription character count; not the transcription itself."},
    "ydotool_socket": {"type": "string", "meaning": "Path checked for the owner input service."},
    "timeout_seconds": {"type": "integer", "meaning": "Budget reported on a recorder stop or upload timeout.", "enum": [3, 30]},
    "http_status": {"type": "integer", "meaning": "Status returned by a refused transcription upload."},
