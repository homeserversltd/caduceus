    },
    "firstMissingSignal": {
      "type": "string",
      "meaning": "Fixed stop outcomes; none denotes success. Dynamic shared-reader diagnostics outside this enum are 'missing envelope kernel keys: <keys>' and 'foreign seat caduceus.staff.v1: <foreign schema repr>'. The stock front door refuses a foreign seat it encounters at startup before invoking this stop.",
      "enum": [
        "none", "invalid JSON", "JSON object required", "foreign envelope schema", "face-dictate-operation-failed",
        "owner-account-missing", "owner-session-identity-refused", "owner-session-socket-ambiguous", "owner-wayland-socket-unavailable", "owner-runuser-unavailable",
        "face-dictate-runtime-directory-unavailable", "face-dictate-runtime-directory-unsafe", "face-dictate-ydotool-socket-unavailable",
        "face-dictate-pw-record-unavailable", "face-dictate-wl-copy-unavailable", "face-dictate-ydotool-unavailable", "face-dictate-notify-send-unavailable", "face-dictate-paplay-unavailable",
        "face-dictate-speech-server-absent", "face-dictate-runtime-file-unsafe", "face-dictate-runtime-file-unavailable",
        "face-dictate-busy", "face-dictate-pid-record-invalid", "face-dictate-owner-exec-failed", "face-dictate-recorder-identity-mismatch",
        "face-dictate-recorder-identity-unavailable", "face-dictate-recorder-start-failed", "face-dictate-recorder-exited", "face-dictate-recorder-stop-timeout",
        "face-dictate-upload-timeout", "face-dictate-upload-failed", "face-dictate-upload-http-failed", "face-dictate-transcription-empty",
        "face-dictate-wl-copy-timeout", "face-dictate-wl-copy-failed", "face-dictate-paste-failed"
      ]
    },
    "socket": {"type": "string", "meaning": "Session key with ambiguous socket observations."}
