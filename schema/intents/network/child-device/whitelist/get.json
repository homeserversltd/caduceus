{
  "schema": "caduceus.staff.v1",
  "intent": "network/child-device/whitelist/get",
  "payload": {
    "fields": {
      "mac": {
        "type": "string",
        "meaning": "Device MAC address. Accepted in compact or six-pair colon/dash form, case-insensitive; the all-zero and broadcast addresses are refused.",
        "pattern": "^(?!(?:0{12}|[fF]{12}|00(?:[:-]00){5}|[fF]{2}(?:[:-][fF]{2}){5})(?![\\s\\S]))(?:[0-9A-Fa-f]{12}|[0-9A-Fa-f]{2}(?:[:-][0-9A-Fa-f]{2}){5})(?![\\s\\S])",
        "maxLength": 17
      }
    },
    "required": [
      "mac"
    ]
  },
  "exousia": false,
  "mutation_allowed": false,
  "returns": {
    "action": {
      "type": "string",
      "meaning": "Operation executed by this stop.",
      "const": "whitelist get"
    },
    "message": {
      "type": "string",
      "meaning": "Human-readable outcome from the registry."
    },
    "device": {
      "type": "object",
      "meaning": "Registered device with its current whitelist.",
      "fields": {
        "mac": {
          "type": "string",
          "meaning": "Device MAC in lowercase colon-separated form."
        },
        "name": {
          "type": "string",
          "meaning": "Stored device label."
        },
        "whitelist": {
          "type": "array",
          "meaning": "Stored, sorted exact hostnames without a trailing dot.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "exceptionType": {
      "type": "string",
      "meaning": "Class of an unhandled exception reported by the staff front door, if any."
    },
    "firstMissingSignal": {
      "type": "string",
      "meaning": "Outcome token; none means the stop completed.",
      "enum": [
        "none",
        "child-device-envelope-invalid",
        "child-device-host-invalid",
        "child-device-mac-invalid",
        "child-device-not-registered",
        "child-device-registry-invalid",
        "child-device-registry-unreadable",
        "agathodaimon-stop-raised"
      ]
    }
  }
}
