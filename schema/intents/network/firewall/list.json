      "meaning": "Human-readable outcome from the firewall actuator."
    },
    "revision": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Digest of the two owned files including presence, or null when no revision could be established.",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "children": {
      "type": "array",
      "meaning": "Registered firewall children, sorted by MAC.",
      "items": {
        "type": "object",
        "fields": {
          "mac": {
            "type": "string",
            "meaning": "Device MAC in lowercase colon-separated form."
          },
          "ip": {
            "type": "string",
            "meaning": "IPv4 address bound to the Kea reservation."
          },
          "hostnames": {
            "type": "array",
            "meaning": "Sorted exact allowed FQDNs with a trailing dot.",
            "items": {
              "type": "string"
            }
          },
          "revision": {
            "type": "string",
            "meaning": "Current digest shared by the registered rows and the top-level revision.",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "enforcement": {
            "type": "string",
            "meaning": "Whether enforcement is applied or the observed lease still differs from the reservation.",
