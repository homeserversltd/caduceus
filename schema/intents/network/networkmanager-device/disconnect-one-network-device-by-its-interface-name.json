{
  "schema": "caduceus.staff.v1",
  "intent": "network/networkmanager-device/disconnect-one-network-device-by-its-interface-name",
  "payload": {
    "fields": {
      "interface": {
        "type": "string",
        "meaning": "NetworkManager interface name. Nonempty UTF-8, at most 128 bytes, with no ASCII control bytes.",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\\u0000-\\u001F\\u007F]+$(?![\\s\\S])"
      }
    },
    "required": [
      "interface"
    ]
  },
  "exousia": true,
  "mutation_allowed": true,
  "returns": {
    "action": {
      "type": "string",
      "meaning": "The selected operation, disconnect, or invalid if the envelope was not read."
    },
    "completed": {
      "type": "boolean",
      "meaning": "True only when the operation returned success; it is not a change flag."
    },
    "firstMissingSignal": {
      "type": "string",
      "meaning": "The stop's outcome token; none when no signal is missing.",
      "enum": [
        "none",
        "wifi-input-invalid",
        "wifi-interface-invalid",
        "wifi-interface-required",
        "wifi-nmcli-failed",
        "wifi-nmcli-stdin-unavailable",
        "wifi-nmcli-stdin-write-failed",
        "wifi-nmcli-timeout",
        "wifi-nmcli-unavailable"
      ]
    }
  }
}
