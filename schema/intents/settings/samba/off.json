        "agathodaimon-settings-samba-nmbd-load-state-unusable",
        "agathodaimon-settings-samba-nmbd-active-state-launch-failed",
        "agathodaimon-settings-samba-nmbd-active-state-unusable",
        "agathodaimon-settings-samba-nmbd-enabled-state-launch-failed",
        "agathodaimon-settings-samba-nmbd-enabled-state-unusable",
        "agathodaimon-settings-samba-envelope-read-failed",
        "agathodaimon-stop-raised",
        "none",
        "agathodaimon-settings-samba-wsdd2-load-state-launch-failed",
        "agathodaimon-settings-samba-wsdd2-load-state-command-failed",
        "agathodaimon-settings-samba-wsdd2-load-state-unusable",
        "agathodaimon-settings-samba-smbd-disable-launch-failed",
        "agathodaimon-settings-samba-smbd-disable-failed",
        "agathodaimon-settings-samba-nmbd-disable-launch-failed",
        "agathodaimon-settings-samba-nmbd-disable-failed",
        "agathodaimon-settings-samba-wsdd2-disable-launch-failed",
