                  "enum": [
                    "enabled",
                    "enabled-runtime",
                    "linked",
                    "linked-runtime",
                    "alias",
                    "masked",
                    "masked-runtime",
                    "static",
                    "indirect",
                    "disabled",
                    "generated",
                    "transient",
                    "unknown"
                  ]
                }
              }
