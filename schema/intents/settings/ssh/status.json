        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "exceptionType": {
      "type": "string",
      "meaning": "Exception class when the shared front door catches an unhandled stop exception."
    },
    "readback": {
      "type": [
        "object",
        "null"
      ],
      "meaning": "Configured and effective directives plus service state; null on a failed status read.",
      "fields": {
        "directives": {
          "type": "object",
          "meaning": "Global SSH authentication directives recognized by this stop; a missing directive is omitted.",
          "fields": {
            "PasswordAuthentication": {
              "type": "string",
              "meaning": "Recognized directive value, in lowercase.",
              "enum": [
                "yes",
                "no"
              ]
            },
            "PubkeyAuthentication": {
              "type": "string",
              "meaning": "Recognized directive value, in lowercase.",
              "enum": [
                "yes",
                "no"
              ]
            }
          }
        },
        "service": {
          "type": "object",
          "meaning": "SSH service observation.",
          "fields": {
            "requestedUnit": {
              "type": "string",
              "meaning": "Canonical requested service name.",
              "const": "sshd.service"
            },
            "unit": {
              "type": "string",
              "meaning": "One of the concrete SSH service units.",
              "enum": [
                "ssh.service",
                "sshd.service"
              ]
            },
            "active": {
              "type": "boolean",
              "meaning": "True when systemctl reports active."
            },
            "activeState": {
              "type": "string",
              "meaning": "systemctl activity output or unknown when empty."
            },
            "enabled": {
              "type": "boolean",
              "meaning": "True when systemctl reports enabled."
            },
            "enabledState": {
              "type": "string",
              "meaning": "systemctl enablement output or unknown when empty."
            }
          }
        },
        "effective": {
          "type": [
            "object",
            "null"
          ],
          "meaning": "Global SSH authentication directives recognized by this stop; a missing directive is omitted.",
          "fields": {
            "PasswordAuthentication": {
              "type": "string",
              "meaning": "Recognized directive value, in lowercase.",
              "enum": [
                "yes",
                "no"
              ]
            },
            "PubkeyAuthentication": {
              "type": "string",
              "meaning": "Recognized directive value, in lowercase.",
              "enum": [
                "yes",
                "no"
              ]
            }
          }
        },
        "effectiveSignal": {
          "type": "string",
          "meaning": "Result of the effective-config probe; a probe failure does not make the status receipt itself fail.",
          "enum": [
            "agathodaimon-ssh-exposure-effective-read-refused",
            "agathodaimon-ssh-exposure-effective-directive-ambiguous",
            "agathodaimon-ssh-exposure-effective-directive-missing",
            "agathodaimon-ssh-exposure-effective-directive-invalid",
            "none"
          ]
        }
