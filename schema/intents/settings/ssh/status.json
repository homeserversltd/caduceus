{
  "schema": "caduceus.staff.v1",
  "intent": "settings/ssh/status",
  "payload": {
    "fields": {},
    "required": []
  },
  "exousia": false,
  "mutation_allowed": false,
  "returns": {
    "state": {
      "type": "string",
      "meaning": "The SSH status observation.",
      "const": "status"
    },
    "changed": {
      "type": "array",
      "meaning": "Empty; status does not change directives."
    },
    "unchanged": {
      "type": "array",
      "meaning": "Empty; status does not apply directives."
    },
    "commands": {
      "type": "array",
      "meaning": "External command argument vectors recorded by the stop.",
