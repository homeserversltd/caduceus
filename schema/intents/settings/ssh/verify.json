{
  "schema": "caduceus.staff.v1",
  "intent": "settings/ssh/verify",
  "payload": {
    "fields": {
      "state": {
        "type": "string",
        "meaning": "Desired SSH exposure state.",
        "enum": [
          "on",
          "off"
        ]
      },
      "unit": {
        "type": "string",
        "meaning": "One of the concrete SSH service units.",
        "enum": [
          "ssh.service",
          "sshd.service"
        ]
      }
    },
    "required": [
      "state",
      "unit"
    ]
  },
  "exousia": false,
  "mutation_allowed": false,
  "returns": {
    "directives": {
      "type": "object",
      "meaning": "The checked PubkeyAuthentication value.",
      "fields": {
        "PubkeyAuthentication": {
          "type": "string",
          "meaning": "Recognized directive value, in lowercase.",
          "enum": [
            "yes",
            "no"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "meaning": "SSH service observation.",
      "fields": {
        "requestedUnit": {
          "type": "string",
          "meaning": "Canonical requested service name.",
          "const": "sshd.service"
        },
        "unit": {
          "type": "string",
          "meaning": "One of the concrete SSH service units.",
          "enum": [
            "ssh.service",
            "sshd.service"
          ]
        },
        "active": {
          "type": "boolean",
          "meaning": "True when systemctl reports active."
        },
        "activeState": {
          "type": "string",
          "meaning": "systemctl activity output or unknown when empty."
        },
        "enabled": {
          "type": "boolean",
          "meaning": "True when systemctl reports enabled."
        },
        "enabledState": {
          "type": "string",
          "meaning": "systemctl enablement output or unknown when empty."
        }
      }
    },
    "commands": {
      "type": "array",
      "meaning": "External command argument vectors recorded by the stop.",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "exceptionType": {
      "type": "string",
      "meaning": "Exception class when the shared front door catches an unhandled stop exception."
    },
    "firstMissingSignal": {
      "type": "string",
      "meaning": "The stop’s first outcome signal, when supplied.",
      "enum": [
        "invalid JSON",
        "JSON object required",
        "foreign envelope schema",
        "missing envelope kernel keys: intent_id",
        "missing envelope kernel keys: transition",
        "missing envelope kernel keys: version",
        "missing envelope kernel keys: timestamp",
        "missing envelope kernel keys: intent_id,transition",
        "missing envelope kernel keys: intent_id,version",
        "missing envelope kernel keys: intent_id,timestamp",
        "missing envelope kernel keys: transition,version",
        "missing envelope kernel keys: transition,timestamp",
        "missing envelope kernel keys: version,timestamp",
        "missing envelope kernel keys: intent_id,transition,version",
        "missing envelope kernel keys: intent_id,transition,timestamp",
        "missing envelope kernel keys: intent_id,version,timestamp",
        "missing envelope kernel keys: transition,version,timestamp",
        "missing envelope kernel keys: intent_id,transition,version,timestamp",
        "payload-not-object",
        "agathodaimon-stop-raised",
        "unsupported-operation",
        "agathodaimon-ssh-exposure-scratch-config-outside-root",
        "agathodaimon-ssh-exposure-config-read-refused",
        "agathodaimon-ssh-exposure-directive-unsupported",
        "agathodaimon-ssh-exposure-directive-ambiguous",
        "agathodaimon-ssh-exposure-service-missing",
        "agathodaimon-ssh-exposure-service-readback-mismatch",
        "agathodaimon-ssh-exposure-config-readback-mismatch",
        "none"
      ],
      "patterns": [
        "^unknown-field:[\\s\\S]*$",
        "^agathodaimon-ssh-exposure-failed:[A-Za-z_][A-Za-z_0-9]*$"
      ]
    }
  }
}
