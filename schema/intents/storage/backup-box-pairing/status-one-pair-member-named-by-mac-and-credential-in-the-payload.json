{
  "schema": "caduceus.staff.v1",
  "intent": "storage/backup-box-pairing/status-one-pair-member-named-by-mac-and-credential-in-the-payload",
  "payload": {
    "fields": {
      "mac": {
        "type": "string",
        "meaning": "Lowercase colon-separated MAC address, exactly 17 ASCII bytes.",
        "pattern": "^[0-9a-f]{2}(?::[0-9a-f]{2}){5}$"
      },
      "credential": {
        "type": "string",
        "meaning": "Pair credential, 32–128 printable ASCII bytes.",
        "secret": true
      }
    },
    "required": [
      "mac",
      "credential"
    ]
  },
  "exousia": false,
  "mutation_allowed": null,
  "returns": {
    "ok": {
      "type": "boolean",
      "meaning": "Whether a matching pair was found."
    },
    "state": {
      "type": "string",
      "meaning": "Matching pair state.",
      "enum": [
        "pending",
        "accepted"
      ]
    },
    "signal": {
      "type": "string",
      "meaning": "Literal handler refusal; absent on success. The door stamp does not copy this value into firstMissingSignal.",
      "enum": [
        "backup-pair-unknown",
        "backup-pair-unavailable"
      ]
    }
  }
}
