{
  "schema": "caduceus.staff.v1",
  "intent": "storage/backup/pair/report",
  "payload": {
    "fields": {
      "mac": {"type": "string", "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$", "meaning": "Lower-case address identifying the paired box."},
      "credential": {"type": "string", "secret": true, "meaning": "Pairing token proving the box; never echoed."},
      "outcome": {"type": "string", "enum": ["ok", "failed", "refused"], "meaning": "Copy outcome."},
      "signal": {"type": "string", "pattern": "^[a-z0-9-]{1,40}$", "meaning": "Bounded copy outcome signal."},
      "at": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$", "meaning": "UTC time of the report."},
      "durationMs": {"type": "integer", "minimum": 0, "meaning": "Copy duration in milliseconds."}
    },
    "required": ["mac", "credential", "outcome", "signal", "at", "durationMs"]
  },
  "exousia": false,
  "mutation_allowed": true,
  "returns": {
    "ok": {"type": "boolean", "meaning": "Whether the report was accepted."},
    "firstMissingSignal": {"type": "string", "enum": ["none", "backup-pair-invalid", "backup-pair-unknown", "backup-pair-unavailable"], "meaning": "Report outcome or refusal."}
  }
}
