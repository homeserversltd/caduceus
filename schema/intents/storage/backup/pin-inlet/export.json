{
  "schema": "caduceus.staff.v1",
  "intent": "storage/backup/pin-inlet/export",
  "payload": {
    "fields": {
      "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,53}_pin_inlet$", "meaning": "Keyman inlet record name."}
    },
    "required": ["name"]
  },
  "exousia": true,
  "mutation_allowed": false,
  "returns": {
    "ok": {"type": "boolean", "meaning": "Whether the inlet was exported."},
    "username": {"type": "string", "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$", "meaning": "Lower-case address of the box."},
    "password": {"type": "string", "secret": true, "minLength": 1, "maxBytes": 511, "pattern": "^[^\u0000\r\n\"]+$", "meaning": "Box PIN for the bounded crossing reader only."},
    "firstMissingSignal": {"type": "string", "enum": ["none", "pin-inlet-name-invalid", "pin-inlet-missing", "pin-inlet-export-failed"], "meaning": "Export outcome or refusal."}
  }
}
