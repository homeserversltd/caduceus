{
  "schema": "caduceus.staff.v1",
  "intent": "storage/nas/detach",
  "payload": {
    "fields": {
      "role": {
        "type": "string",
        "meaning": "Selected NAS role.",
        "enum": [
          "primary",
          "backup"
        ]
      }
    },
    "required": [
      "role"
    ]
  },
  "exousia": true,
  "mutation_allowed": true,
  "returns": {
    "role": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Selected NAS role, or null when it was not available."
    },
    "partlabel": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Role PARTLABEL, when observed."
    },
    "partition": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Partition path, when observed."
    },
    "mapper": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Mapper name, when observed."
    },
    "mountpoint": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Role mountpoint, when supplied."
    },
    "steps": {
      "type": "array",
      "meaning": "Ordered observations and actions. The readback keys depend on the step.",
      "items": {
        "type": "object",
        "fields": {
          "step": {
            "type": "string",
            "meaning": "Name assigned by the stop."
          },
          "ok": {
            "type": "boolean",
            "meaning": "Whether this step passed."
          },
          "readback": {
            "type": "object",
            "meaning": "Step-specific observations."
          }
        }
      }
    },
    "alreadyOpen": {
      "type": "boolean",
      "meaning": "The observed mapper was already open."
    },
    "alreadyMounted": {
      "type": "boolean",
      "meaning": "The role was already mounted."
    },
    "unitsStarted": {
      "type": "array",
      "meaning": "Names of units observed started; direct NAS operations do not start an opener or mount unit.",
      "items": {
        "type": "string"
      }
    },
    "unitStatesBefore": {
      "type": "object",
      "meaning": "Pre-operation unit observations, keyed by unit when available."
    },
    "services": {
      "type": "array",
      "meaning": "Observed NAS-dependent units and their enablement, activity and mount dependency.",
      "items": {
        "type": "object"
      }
    },
    "excludedServices": {
      "type": "array",
      "meaning": "Legacy unit names omitted from the dependent-service census.",
      "items": {
        "type": "string"
      }
    },
    "servicesStarted": {
      "type": "array",
      "meaning": "Names of services observed started by this operation.",
      "items": {
        "type": "string"
      }
    },
    "servicesNotRunning": {
      "type": "array",
      "meaning": "Latest observed inactive or failed states of dependent services.",
      "items": {
        "type": "object"
      }
    },
    "unitsStopped": {
      "type": "array",
      "meaning": "Names of units observed stopped; direct NAS operations do not stop an opener or mount unit.",
      "items": {
        "type": "string"
      }
    },
    "servicesStopped": {
      "type": "array",
      "meaning": "Dependent services observed stopped by this call.",
      "items": {
        "type": "string"
      }
    },
    "mapperReadback": {
      "type": [
        "object",
        "null"
      ],
      "meaning": "Observed mapper existence and backing identity."
    },
    "mountReadback": {
      "type": [
        "object",
        "null"
      ],
      "meaning": "Observed mount presence, filesystem type and mapper identity agreement."
    },
    "shareStep": {
      "type": [
        "object",
        "null"
      ],
      "meaning": "Share rebuild or restoration result, including its cause on failure."
    },
    "shares": {
      "type": "array",
      "meaning": "Share rows reported by the Samba include rebuild.",
      "items": {
        "type": "object"
      }
    },
    "failedStep": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Phase that stopped the operation, if named."
    },
    "returnCode": {
      "type": "integer",
      "meaning": "Exit status of the failed host command, when known."
    },
    "deedLogSignal": {
      "type": "string",
      "meaning": "The deed could not be recorded.",
      "const": "agathodaimon-nas-deed-log-unavailable"
    },
    "mutationOutcome": {
      "type": "string",
      "meaning": "The NAS operation completed but recording its deed failed.",
      "const": "completed-deed-unrecorded"
    },
    "mapperReadbackBefore": {
      "type": "object",
      "meaning": "Mapper observation before detach."
    },
    "mountReadbackBefore": {
      "type": "object",
      "meaning": "Mount observation before unmounting, if the mount existed."
    },
    "firstMissingSignal": {
      "type": "string",
      "meaning": "Outcome token; none means the stop reported no missing signal.",
      "enum": [
        "agathodaimon-nas-block-device-required",
        "agathodaimon-nas-block-graph-incomplete",
        "agathodaimon-nas-block-graph-invalid",
        "agathodaimon-nas-block-holders-invalid",
        "agathodaimon-nas-block-holders-unreadable",
        "agathodaimon-nas-command-group-unreaped",
        "agathodaimon-nas-command-timeout",
        "agathodaimon-nas-command-unavailable",
        "agathodaimon-nas-deed-log-unavailable",
        "agathodaimon-nas-detach-aborted",
        "agathodaimon-nas-device-unobservable",
        "agathodaimon-nas-drive-operation-running",
        "agathodaimon-nas-envelope-kernel-missing",
        "agathodaimon-nas-envelope-schema-foreign",
        "agathodaimon-nas-holder-invalid",
        "agathodaimon-nas-holder-unobservable",
        "agathodaimon-nas-mapper-backing-mismatch",
        "agathodaimon-nas-mapper-backing-unobservable",
        "agathodaimon-nas-mapper-busy",
        "agathodaimon-nas-mapper-invalid",
        "agathodaimon-nas-mapper-not-block",
        "agathodaimon-nas-mapper-readback-failed",
        "agathodaimon-nas-mount-ambiguous",
        "agathodaimon-nas-mount-busy",
        "agathodaimon-nas-mount-census-empty",
        "agathodaimon-nas-mount-census-invalid",
        "agathodaimon-nas-mount-census-unavailable",
        "agathodaimon-nas-mounted-state-mismatch",
        "agathodaimon-nas-partition-holder-ambiguous",
        "agathodaimon-nas-partition-identity-mismatch",
        "agathodaimon-nas-partition-unavailable",
        "agathodaimon-nas-partlabel-absent",
        "agathodaimon-nas-partlabel-missing-or-mismatch",
        "agathodaimon-nas-partlabel-unobservable",
        "agathodaimon-nas-readback-invalid",
        "agathodaimon-nas-request-invalid",
        "agathodaimon-nas-role-invalid",
        "agathodaimon-nas-root-required",
        "agathodaimon-nas-runtime-path-invalid",
        "agathodaimon-nas-scratch-path-escape",
        "agathodaimon-nas-scratch-root-invalid",
        "agathodaimon-nas-scratch-root-unreadable",
        "agathodaimon-nas-scratch-stat-fixture-invalid",
        "agathodaimon-nas-service-census-failed",
        "agathodaimon-nas-service-census-invalid",
        "agathodaimon-nas-service-state-settle-timeout",
        "agathodaimon-nas-service-state-unreadable",
        "agathodaimon-nas-service-stop-busy",
        "agathodaimon-nas-service-stop-failed",
        "agathodaimon-nas-service-unit-unreadable",
        "agathodaimon-nas-share-rebuild-failed",
        "agathodaimon-nas-sync-lock-invalid",
        "agathodaimon-nas-sync-lock-unavailable",
        "none",
        "sync-hold-refused-running"
      ]
    }
  }
}
