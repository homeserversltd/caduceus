{
  "schema": "caduceus.staff.v1",
  "intent": "storage/nas/role/swap",
  "payload": {
    "fields": {},
    "required": []
  },
  "exousia": true,
  "mutation_allowed": true,
  "serve": [
    {
      "stage_id": "hold",
      "snake": "storage/backup/nas-sync/hold"
    },
    {
      "stage_id": "observe-primary",
      "snake": "storage/nas/role/observe",
      "arguments": {
        "role": "primary"
      }
    },
    {
      "stage_id": "observe-backup",
      "snake": "storage/nas/role/observe",
      "arguments": {
        "role": "backup"
      }
    },
    {
      "stage_id": "probe-primary-disk-backup-key",
      "snake": "storage/nas/key/probe",
      "arguments": {
        "key_role": "backup",
        "partition": {
          "$ref": "stages.observe-primary.receipt.partition"
        }
      }
    },
    {
      "stage_id": "probe-backup-disk-primary-key",
      "snake": "storage/nas/key/probe",
      "arguments": {
        "key_role": "primary",
        "partition": {
          "$ref": "stages.observe-backup.receipt.partition"
        }
      }
    },
    {
      "stage_id": "detach-backup",
      "snake": "storage/nas/detach",
      "arguments": {
        "role": "backup"
      },
      "deadline_seconds": 180
    },
    {
      "stage_id": "detach-primary",
      "snake": "storage/nas/detach",
      "arguments": {
        "role": "primary"
      },
      "deadline_seconds": 180
    },
    {
      "stage_id": "label-primary-to-tmp",
      "snake": "storage/disk/partlabel/assign",
      "arguments": {
        "current_label": "homeserver-primary-nas",
        "label": "homeserver-nas-swap-tmp"
      }
    },
    {
      "stage_id": "label-backup-to-primary",
      "snake": "storage/disk/partlabel/assign",
      "arguments": {
        "current_label": "homeserver-backup-nas",
        "label": "homeserver-primary-nas"
      }
    },
    {
      "stage_id": "label-tmp-to-backup",
      "snake": "storage/disk/partlabel/assign",
      "arguments": {
        "current_label": "homeserver-nas-swap-tmp",
        "label": "homeserver-backup-nas"
      }
    },
    {
      "stage_id": "attach-primary",
      "snake": "storage/nas/attach",
      "arguments": {
        "role": "primary"
      },
      "deadline_seconds": 180
    },
    {
      "stage_id": "attach-backup",
      "snake": "storage/nas/attach",
      "arguments": {
        "role": "backup"
      },
      "deadline_seconds": 180
    },
    {
      "stage_id": "observe-after-primary",
      "snake": "storage/nas/role/observe",
      "arguments": {
        "role": "primary"
      }
    },
    {
      "stage_id": "observe-after-backup",
      "snake": "storage/nas/role/observe",
      "arguments": {
        "role": "backup"
      }
    }
  ],
  "finally": [
    {
      "stage_id": "release",
      "snake": "storage/backup/nas-sync/release",
      "depends_on": [
        "hold"
      ],
      "arguments": {
        "hold_id": {
          "$ref": "stages.hold.receipt.holdId"
        }
      }
    }
  ],
  "returns": {
    "routine_id": {
      "type": "string",
      "meaning": "Path of the invoked arpeggio."
    },
    "request": {
      "type": "string",
      "meaning": "Redacted JSON serialization of the input envelope."
    },
    "stages": {
      "type": "array",
      "meaning": "Ordered stage rows, with the receipt of each invoked stage.",
      "items": {
        "type": "object",
        "fields": {
          "stage_id": {
            "type": "string",
            "meaning": "Declared stage identifier."
          },
          "transition": {
            "type": "string",
            "meaning": "Invoked snake path."
          },
          "outcome": {
            "type": "string",
            "meaning": "Whether the stage completed, refused, or was skipped."
          },
          "arguments": {
            "type": "object",
            "meaning": "Resolved per-stage arguments after redaction."
          },
          "receipt": {
            "type": [
              "object",
              "null"
            ],
            "meaning": "The stage receipt with the echoed envelope and raw envelope removed."
          },
          "firstMissingSignal": {
            "type": "string",
            "meaning": "Interruption signal when the walker interrupted this stage."
          }
        }
      }
    },
    "failedStage": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "First required stage that refused, or null if no stage was named."
    },
    "changed": {
      "type": "boolean",
      "meaning": "Known change result. Omitted when the walker cannot determine it."
    },
    "firstMissingField": {
      "type": "string",
      "meaning": "Stage id whose dry-run declaration is missing, when that preflight refuses."
    },
    "firstMissingSignal": {
      "type": "string",
      "meaning": "First blocking walker or stage outcome; none means no missing signal was reported.",
      "enum": [
        "agathodaimon-envelope-invocation-failed",
        "agathodaimon-nas-attach-aborted",
        "agathodaimon-nas-block-device-required",
