{
  "schema": "caduceus.staff.v1",
  "intent": "storage/nas/setup",
  "payload": {
    "fields": {
      "device": {
        "type": "string",
        "meaning": "Whole disk or loop device to set up, named by a single /dev basename; the device is reobserved before a mutation.",
        "pattern": "^/dev/(?!\\.{1,2}$(?![\\s\\S]))[A-Za-z0-9._-]{1,128}$(?![\\s\\S])",
        "maxLength": 133
      },
      "role": {
        "type": "string",
        "meaning": "Selected NAS role.",
        "enum": [
          "primary",
          "backup"
        ]
      }
    },
    "required": [
      "device",
      "role"
    ]
  },
  "exousia": true,
  "mutation_allowed": true,
  "serve": [
    {
      "stage_id": "plan",
      "snake": "storage/nas/setup/plan",
      "arguments": {
        "device": {
          "$ref": "request.payload.device"
        },
        "role": {
          "$ref": "request.payload.role"
        }
      }
    },
    {
      "stage_id": "key-create",
      "snake": "storage/nas/setup/key-create",
      "arguments": {
        "device": {
          "$ref": "request.payload.device"
        },
        "role": {
          "$ref": "request.payload.role"
        }
      }
    },
    {
      "stage_id": "format",
      "snake": "storage/nas/setup/format",
      "arguments": {
        "device": {
          "$ref": "request.payload.device"
        },
        "role": {
          "$ref": "request.payload.role"
        }
      }
    },
    {
      "stage_id": "seat",
      "snake": "storage/nas/setup/seat",
      "arguments": {
        "device": {
          "$ref": "request.payload.device"
        },
        "role": {
          "$ref": "request.payload.role"
        },
        "createdPartitionIdentity": {
          "$ref": "stages.format.receipt.createdPartitionIdentity"
        }
      }
    }
  ],
  "rescue": [
    {
      "stage_id": "rollback",
      "snake": "storage/nas/setup/rollback",
      "on_refusal_of": [
        "key-create",
        "format",
        "seat"
      ],
      "arguments": {
        "device": {
          "$ref": "request.payload.device"
        },
        "role": {
          "$ref": "request.payload.role"
        },
        "createdKeyIdentity": {
          "$ref": "stages.key-create.receipt.createdKeyIdentity"
        },
        "formatOk": {
          "$ref": "stages.format.receipt.ok"
        },
        "diskMutationAttempted": {
          "$ref": "stages.format.receipt.diskMutationAttempted"
        },
        "createdPartitionIdentity": {
          "$ref": "stages.format.receipt.createdPartitionIdentity"
        },
        "deviceIdentity": {
          "$ref": "stages.format.receipt.deviceIdentity"
        },
        "diskCleanVerified": {
          "$ref": "stages.format.receipt.diskCleanVerified"
        },
        "seatMutationAttempted": {
          "$ref": "stages.seat.receipt.mutationAttempted"
        },
        "seatRolledBack": {
          "$ref": "stages.seat.receipt.rolledBack"
        }
      }
    }
  ],
  "returns": {
    "routine_id": {
      "type": "string",
      "meaning": "Path of the invoked arpeggio."
    },
    "request": {
      "type": "string",
      "meaning": "Redacted JSON serialization of the input envelope."
    },
    "stages": {
      "type": "array",
      "meaning": "Ordered stage rows, with the receipt of each invoked stage.",
      "items": {
        "type": "object",
        "fields": {
          "stage_id": {
            "type": "string",
            "meaning": "Declared stage identifier."
          },
          "transition": {
            "type": "string",
            "meaning": "Invoked snake path."
          },
          "outcome": {
            "type": "string",
            "meaning": "Whether the stage completed, refused, or was skipped."
          },
          "arguments": {
            "type": "object",
            "meaning": "Resolved per-stage arguments after redaction."
          },
          "receipt": {
            "type": [
              "object",
              "null"
            ],
            "meaning": "The stage receipt with the echoed envelope and raw envelope removed."
          },
          "firstMissingSignal": {
            "type": "string",
            "meaning": "Interruption signal when the walker interrupted this stage."
          }
        }
      }
    },
    "failedStage": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "First required stage that refused, or null if no stage was named."
    },
    "changed": {
      "type": "boolean",
      "meaning": "Known change result. Omitted when the walker cannot determine it."
    },
    "firstMissingField": {
      "type": "string",
      "meaning": "Stage id whose dry-run declaration is missing, when that preflight refuses."
    },
    "firstMissingSignal": {
      "type": "string",
      "meaning": "First blocking walker or stage outcome; none means no missing signal was reported.",
