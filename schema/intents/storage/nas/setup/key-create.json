{
  "schema": "caduceus.staff.v1",
  "intent": "storage/nas/setup/key-create",
  "payload": {
    "fields": {
      "device": {
        "type": "string",
        "meaning": "Whole disk or loop device to set up, named by a single /dev basename; the device is reobserved before a mutation.",
        "pattern": "^/dev/(?!\\.{1,2}$(?![\\s\\S]))[A-Za-z0-9._-]{1,128}$(?![\\s\\S])",
        "maxLength": 133
      },
      "role": {
        "type": "string",
        "meaning": "Selected NAS role.",
        "enum": [
          "primary",
          "backup"
        ]
      },
      "flash": {
        "type": "boolean",
        "default": false,
        "meaning": "The owner chose Flash it; the preflight allows the requested role's label when it stands only on this disk."
      }
    },
    "required": [
      "device",
      "role"
    ]
  },
  "exousia": true,
  "mutation_allowed": true,
  "returns": {
    "role": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Selected NAS role, or null when it was not available."
    },
    "partlabel": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Role PARTLABEL, when observed."
    },
    "partition": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Partition path, when observed."
    },
    "mapper": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Mapper name, when observed."
    },
    "mountpoint": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Role mountpoint, when supplied."
    },
    "device": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Requested whole device, or null before request validation."
    },
    "steps": {
      "type": "array",
      "meaning": "Ordered observations and actions. The readback keys depend on the step.",
      "items": {
        "type": "object",
        "fields": {
          "step": {
            "type": "string",
            "meaning": "Name assigned by the stop."
          },
          "ok": {
            "type": "boolean",
            "meaning": "Whether this step passed."
          },
          "readback": {
            "type": "object",
            "meaning": "Step-specific observations."
          }
        }
      }
    },
    "failedStep": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Phase that stopped the operation, if named."
    },
    "returnCode": {
      "type": "integer",
      "meaning": "Exit status of the failed host command, when known."
    },
    "servicesStarted": {
      "type": "array",
      "meaning": "Names of services observed started by this operation.",
      "items": {
        "type": "string"
      }
    },
    "servicesNotRunning": {
      "type": "array",
      "meaning": "Latest observed inactive or failed states of dependent services.",
      "items": {
        "type": "object"
      }
    },
    "rolledBack": {
      "type": "boolean",
      "meaning": "This stage does not run rollback.",
      "const": false
    },
    "rollbackSteps": {
      "type": "array",
      "meaning": "Ordered cleanup observations and actions. The readback keys depend on the cleanup step.",
      "items": {
        "type": "object",
        "fields": {
          "step": {
            "type": "string",
            "meaning": "Name assigned by the stop."
          },
          "ok": {
            "type": "boolean",
            "meaning": "Whether this step passed."
          },
          "readback": {
            "type": "object",
            "meaning": "Step-specific observations."
          }
        }
      }
    },
    "services": {
      "type": "array",
      "meaning": "Observed NAS-dependent units and their enablement, activity and mount dependency.",
      "items": {
        "type": "object"
      }
    },
    "excludedServices": {
      "type": "array",
      "meaning": "Legacy unit names omitted from the dependent-service census.",
      "items": {
        "type": "string"
      }
    },
    "keyCreated": {
      "type": "boolean",
      "meaning": "Whether the stage observed creating a new NAS key record; false on reuse."
    },
    "createdKeyIdentity": {
      "type": [
        "object",
        "null"
      ],
      "meaning": "Metadata identity of the key record created by the key-create stage; no key material.",
      "fields": {
        "dev": {
          "type": "integer",
          "meaning": "Device of the key record.",
          "minimum": 0
        },
        "ino": {
          "type": "integer",
          "meaning": "Inode of the key record.",
          "minimum": 0
        },
        "uid": {
          "type": "integer",
          "meaning": "UID of the key record.",
          "minimum": 0
        },
        "mode": {
          "type": "integer",
          "meaning": "Permission mode of the key record.",
          "minimum": 0
        }
      },
      "required": [
        "dev",
        "ino",
        "uid",
        "mode"
      ]
    },
    "deedLogSignal": {
      "type": "string",
      "meaning": "The deed could not be recorded.",
      "const": "agathodaimon-nas-deed-log-unavailable"
    },
    "mutationOutcome": {
      "type": "string",
      "meaning": "The NAS operation completed but recording its deed failed.",
      "const": "completed-deed-unrecorded"
    },
    "firstMissingSignal": {
      "type": "string",
      "meaning": "Outcome token; none means the stop reported no missing signal.",
      "enum": [
        "agathodaimon-nas-block-census-failed",
        "agathodaimon-nas-block-census-invalid",
        "agathodaimon-nas-block-device-required",
        "agathodaimon-nas-block-graph-empty",
        "agathodaimon-nas-block-graph-identity-mismatch",
        "agathodaimon-nas-block-graph-incomplete",
        "agathodaimon-nas-block-graph-invalid",
        "agathodaimon-nas-block-graph-unavailable",
        "agathodaimon-nas-block-identity-unobserved",
        "agathodaimon-nas-command-group-unreaped",
        "agathodaimon-nas-command-timeout",
        "agathodaimon-nas-command-unavailable",
        "agathodaimon-nas-config-absent",
        "agathodaimon-nas-config-application-invalid",
        "agathodaimon-nas-config-applications-invalid",
        "agathodaimon-nas-config-base-invalid",
        "agathodaimon-nas-config-group-invalid",
        "agathodaimon-nas-config-group-unknown",
        "agathodaimon-nas-config-included-invalid",
        "agathodaimon-nas-config-invalid",
        "agathodaimon-nas-config-mode-invalid",
        "agathodaimon-nas-config-path-invalid",
        "agathodaimon-nas-config-path-outside-base",
        "agathodaimon-nas-config-path-outside-mount",
        "agathodaimon-nas-config-paths-invalid",
        "agathodaimon-nas-config-permission-invalid",
        "agathodaimon-nas-config-unreadable",
        "agathodaimon-nas-config-user-invalid",
        "agathodaimon-nas-config-user-unknown",
        "agathodaimon-nas-deed-log-unavailable",
        "agathodaimon-nas-device-changed-before-erasure",
        "agathodaimon-nas-device-identity-mismatch",
        "agathodaimon-nas-device-invalid",
        "agathodaimon-nas-device-mounted",
        "agathodaimon-nas-device-not-in-block-census",
        "agathodaimon-nas-device-unobservable",
        "agathodaimon-nas-drive-operation-running",
        "agathodaimon-nas-envelope-invalid",
        "agathodaimon-nas-envelope-kernel-missing",
        "agathodaimon-nas-envelope-schema-foreign",
        "agathodaimon-nas-key-already-exists",
        "agathodaimon-nas-key-conflict",
        "agathodaimon-nas-key-create-aborted",
        "agathodaimon-nas-key-create-failed",
        "agathodaimon-nas-key-export-failed",
        "agathodaimon-nas-key-export-invalid",
        "agathodaimon-nas-key-export-lock-timeout",
        "agathodaimon-nas-key-raced",
        "agathodaimon-nas-key-record-changed",
        "agathodaimon-nas-key-unobservable",
        "agathodaimon-nas-key-unreadable",
        "agathodaimon-nas-keyman-exchange-cleanup-failed",
        "agathodaimon-nas-keyman-exchange-mount-failed",
        "agathodaimon-nas-keyman-exchange-obliteration-failed",
        "agathodaimon-nas-keyman-exchange-preexisting",
        "agathodaimon-nas-keyman-exchange-raced",
        "agathodaimon-nas-keyman-malformed-key-file",
        "agathodaimon-nas-keyman-missing-key",
        "agathodaimon-nas-keyman-preflight-unobservable",
        "agathodaimon-nas-keyman-service-invalid",
        "agathodaimon-nas-keyman-unavailable",
        "agathodaimon-nas-keyman-uninitialized-system",
        "agathodaimon-nas-mapper-conflict",
        "agathodaimon-nas-mapper-unobservable",
        "agathodaimon-nas-mount-census-empty",
        "agathodaimon-nas-mount-census-invalid",
        "agathodaimon-nas-mount-census-unavailable",
        "agathodaimon-nas-mountpoint-in-use",
        "agathodaimon-nas-mountpoint-not-directory",
        "agathodaimon-nas-mountpoint-not-empty",
        "agathodaimon-nas-mountpoint-unavailable",
        "agathodaimon-nas-mountpoint-unreadable",
        "agathodaimon-nas-partlabel-already-taken",
        "agathodaimon-nas-protected-mount-unobserved",
        "agathodaimon-nas-request-invalid",
        "agathodaimon-nas-role-invalid",
        "agathodaimon-nas-root-mount-unobserved",
        "agathodaimon-nas-root-required",
