{
  "schema": "caduceus.staff.v1",
  "intent": "storage/nas/setup/seat",
  "payload": {
    "fields": {
      "device": {
        "type": "string",
        "meaning": "Whole disk or loop device to set up, named by a single /dev basename; the device is reobserved before a mutation.",
        "pattern": "^/dev/(?!\\.{1,2}$(?![\\s\\S]))[A-Za-z0-9._-]{1,128}$(?![\\s\\S])",
        "maxLength": 133
      },
      "role": {
        "type": "string",
        "meaning": "Selected NAS role.",
        "enum": [
          "primary",
          "backup"
        ]
      },
      "createdPartitionIdentity": {
        "type": "string",
        "meaning": "Major:minor identity returned by the format stage for the newly created partition.",
        "pattern": "^[0-9]+:[0-9]+$(?![\\s\\S])"
      }
    },
    "required": [
      "device",
      "role",
      "createdPartitionIdentity"
    ]
  },
  "exousia": true,
  "mutation_allowed": true,
  "returns": {
    "role": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Selected NAS role, or null when it was not available."
    },
    "partlabel": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Role PARTLABEL, when observed."
    },
    "partition": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Partition path, when observed."
    },
    "mapper": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Mapper name, when observed."
    },
    "mountpoint": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Role mountpoint, when supplied."
    },
    "device": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Requested whole device, or null before request validation."
    },
    "steps": {
      "type": "array",
      "meaning": "Ordered observations and actions. The readback keys depend on the step.",
      "items": {
        "type": "object",
        "fields": {
          "step": {
            "type": "string",
            "meaning": "Name assigned by the stop."
          },
          "ok": {
            "type": "boolean",
            "meaning": "Whether this step passed."
          },
          "readback": {
            "type": "object",
            "meaning": "Step-specific observations."
          }
        }
      }
    },
    "failedStep": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Phase that stopped the operation, if named."
    },
    "returnCode": {
      "type": "integer",
      "meaning": "Exit status of the failed host command, when known."
    },
    "servicesStarted": {
      "type": "array",
      "meaning": "Names of services observed started by this operation.",
      "items": {
        "type": "string"
      }
    },
    "servicesNotRunning": {
      "type": "array",
      "meaning": "Latest observed inactive or failed states of dependent services.",
      "items": {
        "type": "object"
      }
    },
    "rolledBack": {
      "type": "boolean",
      "meaning": "Whether at least one rollback step ran and every such step passed."
    },
    "rollbackSteps": {
      "type": "array",
      "meaning": "Ordered cleanup observations and actions. The readback keys depend on the cleanup step.",
      "items": {
        "type": "object",
        "fields": {
          "step": {
            "type": "string",
            "meaning": "Name assigned by the stop."
          },
          "ok": {
            "type": "boolean",
            "meaning": "Whether this step passed."
          },
          "readback": {
            "type": "object",
            "meaning": "Step-specific observations."
          }
        }
      }
    },
    "services": {
      "type": "array",
      "meaning": "Observed NAS-dependent units and their enablement, activity and mount dependency.",
      "items": {
        "type": "object"
      }
    },
    "excludedServices": {
      "type": "array",
      "meaning": "Legacy unit names omitted from the dependent-service census.",
      "items": {
        "type": "string"
      }
    },
    "createdPartitionIdentity": {
      "type": [
        "string",
        "null"
      ],
      "meaning": "Major:minor identity returned by the format stage for the newly created partition.",
      "pattern": "^[0-9]+:[0-9]+$(?![\\s\\S])"
    },
    "mutationAttempted": {
      "type": "boolean",
      "meaning": "Whether the stage reached mapper-open or mount work."
    },
    "firstMissingField": {
      "type": "string",
      "meaning": "The missing or invalid format partition witness.",
      "const": "createdPartitionIdentity"
    },
    "unitStatesBefore": {
      "type": "object",
      "meaning": "Pre-operation unit observations when supplied by attachment."
    },
    "deedLogSignal": {
      "type": "string",
      "meaning": "The deed could not be recorded.",
      "const": "agathodaimon-nas-deed-log-unavailable"
    },
    "mutationOutcome": {
      "type": "string",
      "meaning": "The NAS operation completed but recording its deed failed.",
      "const": "completed-deed-unrecorded"
    },
    "firstMissingSignal": {
      "type": "string",
      "meaning": "Outcome token; none means the stop reported no missing signal.",
      "enum": [
        "agathodaimon-nas-attach-aborted",
        "agathodaimon-nas-attach-not-transaction-owned",
        "agathodaimon-nas-block-census-failed",
        "agathodaimon-nas-block-census-invalid",
        "agathodaimon-nas-block-device-required",
