        "pattern": "^[^\\r\\n\\u0000]+$"
      },
      "password": {
        "type": "string",
        "meaning": "Required for replace; nonempty UTF-8 text with no CR, LF or NUL. Stdin only; not echoed.",
        "minLength": 1,
        "pattern": "^[^\\r\\n\\u0000]+$"
      },
      "args": {
        "type": "array",
        "meaning": "An empty list uses action or transition selection; one action word takes precedence over other selectors.",
        "maxItems": 1,
        "items": {"type": "string", "enum": ["status", "replace", "rotate"]}
      }
    },
    "required": []
