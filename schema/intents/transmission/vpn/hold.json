    "peerPortReadback": {"type": ["integer", "null"], "meaning": "Confirmed RPC peer-port or null."},
    "peerPortReadbackAt": {"type": ["string", "null"], "meaning": "Time of the confirmed peer-port readback or null."},
    "ready": {"type": "boolean", "meaning": "The hold sent READY after publishing and reading back its bind state."},
    "stopped": {"type": "boolean", "meaning": "The hold left its keepalive loop on a stop request."},
    "stopSignal": {"type": ["string", "null"], "meaning": "Signal that requested the orderly stop."},
    "tripMarkerWritten": {"type": "boolean", "meaning": "Whether a runtime trip marker was written."},
    "tripMarkerError": {
      "type": "string",
      "meaning": "Trip marker publication failed.",
      "const": "transmission-trip-marker-write-failed"
