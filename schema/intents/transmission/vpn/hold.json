{
  "schema": "caduceus.staff.v1",
  "intent": "transmission/vpn/hold",
  "payload": {
    "fields": {
      "provider": {
        "type": ["string", "null"],
        "meaning": "Legacy provider override. Null selects the default provider; on omission the standing choice applies. A VPN flag wins over this alias.",
        "enum": ["pia", null]
      },
      "flags": {
        "type": "object",
        "meaning": "Payload-carried flags; VPN options can also ride in the envelope flags. The envelope carrier wins over the payload carrier, and flags.vpn wins over flags.exousia.vpn within each carrier.",
        "fields": {
          "vpn": {
            "type": ["object", "null"],
            "meaning": "Overrides the standing Transmission VPN options field by field. A null family resets all options to the primitive.",
            "fields": {
              "provider": {
                "type": ["string", "null"],
                "meaning": "Provider override; null selects pia.",
                "enum": ["pia", null]
              },
              "protocol": {
                "type": ["string", "null"],
                "meaning": "Provider protocol override; null selects openvpn for PIA.",
                "enum": ["openvpn", "wireguard", null]
              },
              "region": {
                "type": ["string", "null"],
                "meaning": "Provider region ID. Null leaves automatic region selection; an explicit ID must resolve at the provider where a provider endpoint is selected.",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                "maxLength": 64
              },
              "dip": {"type": ["boolean", "null"], "meaning": "Request a dedicated IP; null selects false."},
              "dns": {
                "type": ["string", "null"],
                "meaning": "Use provider DNS; null selects the public resolver in the namespace setup.",
                "enum": ["provider", null]
              },
              "rescan": {
                "type": ["boolean", "null"],
                "meaning": "Request the RPC torrent rescan after applying download settings; null selects false."
              }
            }
          },
          "exousia": {
            "type": "object",
            "meaning": "Legacy scoped VPN flag carrier.",
            "fields": {
              "vpn": {
                "type": ["object", "null"],
                "meaning": "Overrides the standing Transmission VPN options field by field. A null family resets all options to the primitive.",
                "fields": {
                  "provider": {
                    "type": ["string", "null"],
                    "meaning": "Provider override; null selects pia.",
                    "enum": ["pia", null]
                  },
                  "protocol": {
                    "type": ["string", "null"],
                    "meaning": "Provider protocol override; null selects openvpn for PIA.",
                    "enum": ["openvpn", "wireguard", null]
                  },
                  "region": {
                    "type": ["string", "null"],
                    "meaning": "Provider region ID. Null leaves automatic region selection; an explicit ID must resolve at the provider where a provider endpoint is selected.",
                    "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                    "maxLength": 64
                  },
                  "dip": {"type": ["boolean", "null"], "meaning": "Request a dedicated IP; null selects false."},
                  "dns": {
                    "type": ["string", "null"],
                    "meaning": "Use provider DNS; null selects the public resolver in the namespace setup.",
                    "enum": ["provider", null]
                  },
                  "rescan": {
                    "type": ["boolean", "null"],
                    "meaning": "Request the RPC torrent rescan after applying download settings; null selects false."
                  }
                }
              }
            }
          }
        }
      }
    },
    "required": []
  },
  "exousia": false,
  "mutation_allowed": true,
  "returns": {
    "provider": {"type": ["string", "null"], "meaning": "Selected provider, or null if selection did not complete."},
    "steps": {
      "type": "array",
      "meaning": "Operation or observation rows, each carrying step, observed, could-change, attempt and finalState."
    },
    "field": {"type": "string", "meaning": "Name of the invalid VPN option."},
    "providers": {"type": "array", "meaning": "Provider names from the VPN declaration."},
    "nativeUnit": {"type": "string", "meaning": "Name of the native Transmission systemd unit."},
    "boundProvider": {"type": "string", "meaning": "Provider bound to the native unit."},
    "requestedProvider": {"type": "string", "meaning": "Resolved provider requested for the native unit."},
    "boundProviders": {"type": "array", "meaning": "Matching providers when the native unit binding is ambiguous or absent."},
    "failedRung": {"type": "string", "meaning": "Rung at which the operation stopped."},
    "failedCommandError": {"type": "object", "meaning": "Signal and step identifying the failed command or operation."},
    "call": {"type": "string", "meaning": "Name of the failed provider or RPC call."},
    "curlError": {"type": "string", "meaning": "Redacted transport or response diagnostic."},
    "protocol": {"type": ["string", "null"], "meaning": "Selected VPN protocol, or null if unavailable."},
    "tunnelInterface": {"type": ["string", "null"], "meaning": "Tunnel interface name, or null if no interface was read."},
    "unitOverridePropagated": {"type": "boolean", "meaning": "No unit-level VPN override is propagated.", "const": false},
    "nextStartConfigurationSource": {"type": "string", "meaning": "Appliance configuration read at next start."},
    "forwardPort": {"type": "integer", "meaning": "Bound provider forward port."},
    "keepaliveInterval": {"type": "integer", "meaning": "Provider keepalive interval in seconds."},
    "peerPortApplied": {"type": "boolean", "meaning": "A peer-port application and readback were confirmed."},
