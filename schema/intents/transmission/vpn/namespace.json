    "field": {"type": "string", "meaning": "Name of the invalid VPN option."},
    "providers": {"type": "array", "meaning": "Provider names from the VPN declaration."},
    "failedRung": {"type": "string", "meaning": "Rung at which the operation stopped."},
    "failedCommandError": {"type": "object", "meaning": "Signal and step identifying the failed command or operation."},
    "call": {"type": "string", "meaning": "Name of the failed provider or RPC call."},
    "curlError": {"type": "string", "meaning": "Redacted transport or response diagnostic."},
    "protocol": {"type": ["string", "null"], "meaning": "Selected VPN protocol, or null if unavailable."},
