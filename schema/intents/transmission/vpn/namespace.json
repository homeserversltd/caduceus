{
  "schema": "caduceus.staff.v1",
  "intent": "transmission/vpn/namespace",
  "payload": {
    "fields": {
      "provider": {
        "type": ["string", "null"],
        "meaning": "Legacy provider override. Null selects the default provider; on omission the standing choice applies. A VPN flag wins over this alias.",
        "enum": ["pia", null]
      },
      "flags": {
        "type": "object",
        "meaning": "Payload-carried flags; VPN options can also ride in the envelope flags. The envelope carrier wins over the payload carrier, and flags.vpn wins over flags.exousia.vpn within each carrier.",
        "fields": {
          "vpn": {
            "type": ["object", "null"],
            "meaning": "Overrides the standing Transmission VPN options field by field. A null family resets all options to the primitive.",
            "fields": {
              "provider": {
                "type": ["string", "null"],
                "meaning": "Provider override; null selects pia.",
                "enum": ["pia", null]
              },
              "protocol": {
                "type": ["string", "null"],
                "meaning": "Provider protocol override; null selects openvpn for PIA.",
                "enum": ["openvpn", "wireguard", null]
              },
              "region": {
                "type": ["string", "null"],
                "meaning": "Provider region ID. Null leaves automatic region selection; an explicit ID must resolve at the provider where a provider endpoint is selected.",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                "maxLength": 64
              },
              "dip": {"type": ["boolean", "null"], "meaning": "Request a dedicated IP; null selects false."},
              "dns": {
                "type": ["string", "null"],
                "meaning": "Use provider DNS; null selects the public resolver in the namespace setup.",
                "enum": ["provider", null]
              },
              "rescan": {
                "type": ["boolean", "null"],
                "meaning": "Request the RPC torrent rescan after applying download settings; null selects false."
              }
            }
          },
          "exousia": {
            "type": "object",
            "meaning": "Legacy scoped VPN flag carrier.",
            "fields": {
              "vpn": {
                "type": ["object", "null"],
                "meaning": "Overrides the standing Transmission VPN options field by field. A null family resets all options to the primitive.",
