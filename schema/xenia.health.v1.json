    },
    "source_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "field_types": {
    "schema": "string",
    "ok": "boolean",
    "service": "string",
    "version": "string",
    "source_sha": "string|null"
  },
  "required": [
